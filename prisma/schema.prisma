generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  REVISION_REQUIRED
  APPROVED
  PUBLISHED
  FUNDING
  IMPLEMENTATION
  COMPLETED
  ARCHIVED
}

enum OrganizationRole {
  OWNER
  ADMIN
  EDITOR
  REVIEWER
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  organizationMembers OrganizationMember[]
  savedProjects       SavedProject[]
  tourSessions        TourSession[]
}

model Organization {
  id          String               @id @default(cuid())
  name        String
  slug        String               @unique
  description String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  members     OrganizationMember[]
  projects    Project[]
}

model OrganizationMember {
  id             String           @id @default(cuid())
  role           OrganizationRole @default(EDITOR)
  userId         String
  organizationId String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Project {
  id               String          @id @default(cuid())
  slug             String          @unique
  status           ProjectStatus   @default(DRAFT)
  organizationId   String
  municipality     String
  latitude         Decimal?        @db.Decimal(9, 6)
  longitude        Decimal?        @db.Decimal(9, 6)
  fundingGoalCents Int?
  fundedCents      Int             @default(0)
  publishedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  organization     Organization    @relation(fields: [organizationId], references: [id])
  translations     ProjectTranslation[]
  categories       ProjectCategoryAssignment[]
  impactMetrics    ProjectImpactMetric[]
  updates          ProjectUpdate[]
  savedBy          SavedProject[]

  @@index([status, publishedAt])
  @@index([municipality])
}

model ProjectTranslation {
  id          String  @id @default(cuid())
  locale      String
  title       String
  summary     String
  description String
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, locale])
}

model ProjectCategory {
  id       String                      @id @default(cuid())
  slug     String                      @unique
  name     String
  projects ProjectCategoryAssignment[]
}

model ProjectCategoryAssignment {
  projectId  String
  categoryId String
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category   ProjectCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([projectId, categoryId])
}

model ProjectImpactMetric {
  id        String  @id @default(cuid())
  label     String
  value     Decimal @db.Decimal(12, 2)
  unit      String
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectUpdate {
  id          String   @id @default(cuid())
  title       String
  body        String
  publishedAt DateTime @default(now())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model SavedProject {
  userId    String
  projectId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
}

model TourSession {
  id          String         @id @default(cuid())
  userId      String?
  locale      String         @default("de")
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  responses   TourResponse[]
  result      ScoreResult?
}

model TourResponse {
  id        String      @id @default(cuid())
  roomKey   String
  answerKey String
  value     Json
  sessionId String
  session   TourSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, roomKey])
}

model ScoreResult {
  id                String      @id @default(cuid())
  biodiversityScore Int
  carbonScore       Int
  waterScore        Int
  resourceScore     Int
  modelVersion      String
  sessionId         String      @unique
  session           TourSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}
